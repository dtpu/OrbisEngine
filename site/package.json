{
  "name": "wander-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port 5400 --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" index.html package.json tsconfig.json vite.config.ts",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"scripts/**/*.ts\" index.html package.json tsconfig.json vite.config.ts",
    "test:smoke": "bun run tests/smoke.ts"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "vite": "8.3.0"
  },
  "prettier": {
    "singleQuote": true,
    "printWidth": 100,
    "tabWidth": 2
  }
}
