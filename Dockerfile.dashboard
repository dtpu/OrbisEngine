FROM oven/bun:1.3.14 AS build

WORKDIR /app
RUN bun add --no-save vite@8.3.0 typescript@5.9.3
COPY dashboard.html vite.dashboard.config.ts tsconfig.json ./
COPY src ./src
RUN bunx --bun vite build --config vite.dashboard.config.ts

FROM nginxinc/nginx-unprivileged:1.29.1-alpine
COPY orchestrator/deployment/dashboard-nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080
