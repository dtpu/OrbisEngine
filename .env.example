# Save private teammate values in .env.local (gitignored).
# These are server-only credentials. Never prefix them with VITE_.
WANDER_ASSET_ACCESS_KEY_ID=
WANDER_ASSET_SECRET_ACCESS_KEY=
# WANDER_ASSET_SESSION_TOKEN=
# WANDER_ASSETS_MODE=local

# Optional VR voice prototype: set this in private .env.local for the Vite server.
# OPENAI_API_KEY=''
# WANDER_AGENT_MODEL=gpt-realtime

# Author pipeline: copy this block into private .env.author and uncomment what you use.
# Python does not load dotenv files automatically. From the repo root:
#   set -a; source .env.author; set +a
# See docs/shared-assets.md#author-credentials for workspace/key setup.
# WLT_API_KEY=''
# OPENAI_API_KEY=''
# MODAL_PROFILE=dtpu
# Prefer your own Modal token stored under profile dtpu. Optional environment-token route:
# MODAL_TOKEN_ID=''
# MODAL_TOKEN_SECRET=''
# AWS publisher: choose an author profile OR the standard environment-key trio, not both.
# AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=''
# AWS_SECRET_ACCESS_KEY=''
# AWS_SESSION_TOKEN=''  # only for temporary credentials
# Optional local tool/output overrides:
# WANDER_PYTHON=/absolute/path/to/python
# WANDER_MODAL=/absolute/path/to/modal
# WANDER_SHARE_DIR=/absolute/path/to/evidence
# WANDER_EVIDENCE_DIR=/absolute/path/to/evidence-to-publish
# WANDER_CLIPS_DIR=/absolute/path/to/cleaned-clips
# WANDER_MARBLE_DIR=/absolute/path/to/marble-records
# WANDER_GPU_BOX=user@host
# WANDER_GPU_KEY=/absolute/path/to/ssh-key
