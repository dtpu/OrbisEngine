{
  "name": "wander",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Step inside any video: one 2D clip -> orbitable 3D moment in the browser",
  "scripts": {
    "dev": "vite --port 5399 --host 127.0.0.1",
    "demo": "vite --port 5399 --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "runs:publish": "node scripts/publish-runs.mjs",
    "test:shared-assets": "node --test scripts/test-shared-assets.mjs",
    "test:publish-hook": "python3 scripts/test_run_clip_publish.py",
    "test:audio": "node scripts/test-fourd-audio.mjs",
    "test:audio-browser": "node scripts/test-fourd-audio-browser.mjs",
    "smoke:xr": "node scripts/smoke-xr.mjs",
    "capture:shared": "node scripts/capture-shared-demo.mjs",
    "capture:walk": "node scripts/capture-walk-attack.mjs",
    "capture:collision": "node scripts/capture-walk-collide.mjs",
    "capture:audio": "node scripts/capture-audio-demo.mjs",
    "test:audio-package": "python3 scripts/test_package_audio.py"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "@sparkjsdev/spark": "^2.2.0",
    "three": "^0.186.0",
    "webxr-polyfill": "^2.0.3"
  },
  "devDependencies": {
    "@types/three": "^0.186.0",
    "playwright-core": "1.63.0",
    "typescript": "^5.9.0",
    "vite": "^8.3.0"
  },
  "engines": {
    "node": "^22.12.0 || >=24.0.0"
  }
}
